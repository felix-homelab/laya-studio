# Laya Studio — copy to .env and edit. Every value is optional; the defaults are
# shown commented out. The full reference is docs/configuration.md.

# --- application -------------------------------------------------------------
# LAYA_STUDIO_ENVIRONMENT=development
# LAYA_STUDIO_LOG_LEVEL=INFO
# LAYA_STUDIO_SECRET_KEY=change-me-in-production
# LAYA_STUDIO_CORS_ORIGINS=

# --- database (the plain postgresql:// form, so Prisma can read it too) --------
# LAYA_STUDIO_DATABASE_URL=postgresql://laya:laya@localhost:5432/laya_studio
# Only for `make db-diff`; Prisma resets this database.
# LAYA_STUDIO_SHADOW_DATABASE_URL=

# --- docker compose ----------------------------------------------------------
# POSTGRES_USER=laya
# POSTGRES_PASSWORD=laya
# POSTGRES_DB=laya_studio

# --- inference ---------------------------------------------------------------
# LAYA_STUDIO_LAYA_PRELOAD=true
# LAYA_STUDIO_LAYA_DEVICE=auto
# LAYA_STUDIO_LAYA_CACHE_DIR=
# LAYA_STUDIO_LAYA_TOKEN=
# LAYA_STUDIO_LAYA_OFFLINE=false

# --- the confidence ladder ---------------------------------------------------
# LAYA_STUDIO_AUTO_THRESHOLD=0.90
# LAYA_STUDIO_VERIFY_THRESHOLD=0.60

# --- generative fallback -----------------------------------------------------
# LAYA_STUDIO_LLM_PROVIDER=none
# LAYA_STUDIO_OPENAI_API_KEY=
# LAYA_STUDIO_OPENAI_MODEL=gpt-4o-mini
# LAYA_STUDIO_ANTHROPIC_API_KEY=
# LAYA_STUDIO_ANTHROPIC_MODEL=claude-3-5-haiku-latest

# --- actions -----------------------------------------------------------------
# LAYA_STUDIO_WEBHOOK_ALLOWED_HOSTS=
# LAYA_STUDIO_EMAIL_ENABLED=false
# LAYA_STUDIO_SMTP_HOST=
# LAYA_STUDIO_SMTP_PORT=587
# LAYA_STUDIO_SMTP_USERNAME=
# LAYA_STUDIO_SMTP_PASSWORD=
# LAYA_STUDIO_SMTP_FROM=laya-studio@localhost

# --- access tokens (unset = open; set all three outside a trusted network) ----
# LAYA_STUDIO_INGEST_TOKEN=
# LAYA_STUDIO_OBSERVABILITY_TOKEN=
# LAYA_STUDIO_MCP_TOKEN=
